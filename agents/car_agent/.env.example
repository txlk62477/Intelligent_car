# 复制为 .env 后填写真实值；不要提交 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MAX_OUTPUT_TOKENS=2048

# Agent Server 长期记忆作用域；正式认证用户优先于 CAR_AGENT_USER_ID。
CAR_AGENT_USER_ID=local-user
CAR_ROBOT_ID=xuegecar-01

# Store 语义检索：Agent Server 容器通过 host.docker.internal 访问宿主机 Ollama。
OLLAMA_EMBEDDING_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBEDDING_TIMEOUT=8

# 图像识别：默认使用本机 Ollama；目录之间用操作系统路径分隔符分开。
VISION_PROVIDER=ollama
VISION_ALLOWED_IMAGE_DIRS=/home/lk/car/test/fixtures:/home/lk/car/data/images
VISION_DEFAULT_QUESTION=请简短描述图片中的主要内容。
VISION_MAX_IMAGE_BYTES=10485760

OLLAMA_VISION_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen3-vl:4b-instruct
OLLAMA_VISION_KEEP_ALIVE=30m
OLLAMA_VISION_TIMEOUT=120
OLLAMA_VISION_NUM_PREDICT=64

# 仅在 VISION_PROVIDER=baidu 时需要；不要提交真实密钥。
BAIDU_BASE_URL=https://aip.baidubce.com
BAIDU_API_KEY=
BAIDU_SECRET_KEY=
BAIDU_VISION_POLL_INTERVAL=0.3
BAIDU_VISION_TIMEOUT=30
BAIDU_VISION_MAX_RETRIES=1

# Robot Gateway：常规接口超时 2 秒；检测探测可能触发 YOLO 冷启动，单独放宽。
ROBOT_GATEWAY_URL=http://127.0.0.1:8765
ROBOT_GATEWAY_HTTP_TIMEOUT=2.0
ROBOT_GATEWAY_DETECTIONS_TIMEOUT=20.0

# LangSmith 可观测性
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=intelligent-car-agent
